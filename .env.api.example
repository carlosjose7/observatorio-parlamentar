# .env.api.example — Template do ambiente MÍNIMO da API (compose: API_ENV_FILE).
#
# A API lê APENAS o DuckDB da camada Gold em modo read-only (ADR-026): o
# env dela não contém segredos de pipeline. Credenciais MinIO são injetadas
# pelo docker-compose via `environment`, interpoladas do .env do projeto.
#
# Copie para `.env.api` e ajuste se necessário.

DUCKDB_DATABASE_PATH=data/silver/observatorio.duckdb
LOG_LEVEL=INFO

# Desabilitar /docs e /openapi.json publicamente em produção (recomendado):
# API_DOCS_ENABLED=false
