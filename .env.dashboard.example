# .env.dashboard.example — Template do ambiente MÍNIMO do dashboard Streamlit.
#
# O dashboard NUNCA abre DuckDB/MinIO nem recebe chaves de API: consome apenas
# a REST API como fronteira de leitura (RF-05, ADR-026). Em dev local sem
# docker, aponte para a API que estiver rodando.
#
# Copie para `.env.dashboard` e ajuste se necessário.

API_URL=http://api:8000
LOG_LEVEL=INFO
