# Never commit a populated .env file. Copy this file to `.env` and fill values.

# ── Segredos do pipeline ─────────────────────────────────────────
# Chave HMAC-SHA256 para pseudonimização de CPF de fornecedores PF (ADR-004/011)
CPF_HMAC_SECRET_KEY=replace-with-a-long-random-secret

# Portal da Transparência (CGU) — obter chave em:
# https://www.portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# (requer conta Gov.br nível Prata/Ouro)
CGU_API_KEY=replace-with-your-cgu-api-key

# ── Object Storage (MinIO) ───────────────────────────────────────
# Valor com scheme — deve bater com o docker-compose.yml (ex: http://minio:9000).
# config.py normaliza para o cliente minio-py (remove o scheme).
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=observatorio_admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# ── Postgres (Airflow metadata DB) ──────────────────────────────
# POSTGRES_USER/DB têm default no docker-compose.yml; apenas a senha é obrigatória.
# Evite os caracteres reservados de URL (@ : / ?) na senha, pois ela entra na
# connection string SQLAlchemy do Airflow.
POSTGRES_USER=airflow
POSTGRES_DB=airflow
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# ── Airflow ──────────────────────────────────────────────────────
# Chave Fernet para criptografia de conexões/variables (ver docker-compose.yml).
# Gere uma nova com:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=replace-with-a-fernet-key

# Credencial administrativa do Airflow webserver (criada no entrypoint oficial
# via _AIRFLOW_WWW_USER_CREATE — a senha NUNCA vai em linha de comando).
# O docker-compose.yml falha se AIRFLOW_ADMIN_PASSWORD/AIRFLOW_FERNET_KEY
# não estiverem definidas no .env.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-a-strong-admin-password
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ── Grafana (Sprint 23, ADR-053) ────────────────────────────────
# UI em 127.0.0.1:3000, sem Nginx. A senha NUNCA vai em arquivo versionado.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

# ── Alertmanager (Sprint 26, Onda 6, ADR-056 D6) ─────────────────
# Roteador das 14 regras (UI em 127.0.0.1:9093, sem Nginx). Destino default
# `blackhole` (sem destino real) — para ativar o Slack, des-comentar o
# receiver/rota em infra/observability/alertmanager.yml e preencher abaixo.
# Pendente de confirmação do PO (existe webhook?). NUNCA versionar valor real.
SLACK_WEBHOOK_URL=

# ── URLs externas p/ links de alerta (hotfix pós-Sprint 26) ───────
# Prometheus/Alertmanager geram links "Source" com o hostname interno do
# container (inútil no celular). Com estes valores, os links apontam para
# localhost — abra túnel SSH para usá-los:
#   ssh -L 9090:localhost:9090 -L 9093:localhost:9093 opc@<VPS>
# Se o acesso for por outro host/IP, sobrescreva no `.env` real.
PROMETHEUS_EXTERNAL_URL=http://localhost:9090
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093

# ── Runtime ──────────────────────────────────────────────────────
DUCKDB_DATABASE_PATH=data/silver/observatorio.duckdb
LOG_LEVEL=INFO
