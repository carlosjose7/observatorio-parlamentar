# .env.hml.example — Template do ambiente HML (homologação).
#
# Copie para `.env.hml` e preencha com valores próprios do HML (isolados do
# PRD). O `.env.hml` real NÃO é versionado (.gitignore cobre .env.*).
#
# Uso: docker compose --env-file .env.hml -p hml ...

# Segredos (CPF/HMAC) e chave da API da CGU — valores próprios do HML.
CPF_HMAC_SECRET_KEY=CHANGE_ME_HML
CGU_API_KEY=CHANGE_ME_HML

# MinIO — endpoint interno Docker (rede isolada hml_observatorio-net).
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=observatorio_hml
MINIO_ROOT_PASSWORD=CHANGE_ME_HML

# Postgres (airflow metadata DB) — credenciais do HML.
POSTGRES_USER=airflow
POSTGRES_DB=airflow
POSTGRES_PASSWORD=CHANGE_ME_HML

# Airflow — gere um Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME_HML
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_HML

# Caminho do DuckDB relativo ao mount ./data.hml:/opt/airflow/data.
DUCKDB_DATABASE_PATH=data/silver/observatorio.duckdb
LOG_LEVEL=INFO

# Isolamento: os serviços HML (postgres/minio/api) devem ler ESTE arquivo,
# nunca o .env do PRD (senão as credenciais do HML não batem com o MinIO HML).
PIPELINE_ENV_FILE=.env.hml
MINIO_ENV_FILE=.env.hml
API_ENV_FILE=.env.hml