{
 "uid": "observatorio-slos",
 "title": "Observatório Parlamentar — SLOs",
 "tags": [
  "observabilidade",
  "sprint-23"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 2,
 "panels": [
  {
   "id": 1,
   "title": "API p95 vs SLO 500ms",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(http_latency_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       },
       {
        "value": 0.5,
        "color": "red"
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   }
  },
  {
   "id": 2,
   "title": "Freshness watermark vs 24h/26h",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "pipeline_watermark_lag_hours",
     "legendFormat": "{{fonte}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "h",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       },
       {
        "value": 24,
        "color": "orange"
       },
       {
        "value": 26,
        "color": "red"
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   }
  },
  {
   "id": 3,
   "title": "Quarentena vs 2%/5%",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(dq_quarentena) / sum(dq_total)",
     "legendFormat": "global",
     "refId": "A"
    },
    {
     "expr": "dq_quarentena / dq_total",
     "legendFormat": "{{tabela}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       },
       {
        "value": 0.02,
        "color": "orange"
       },
       {
        "value": 0.05,
        "color": "red"
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   }
  },
  {
   "id": 4,
   "title": "DQ por tabela",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "dq_regras_violadas",
     "legendFormat": "{{tabela}} {{regra}}",
     "refId": "A"
    },
    {
     "expr": "dq_nulos_ratio",
     "legendFormat": "nulos {{tabela}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   }
  },
  {
   "id": 5,
   "title": "Tasks: status (Sprint 26)",
   "type": "state-timeline",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "pipeline_task_last_run_status == 1",
     "legendFormat": "{{task}}:{{status}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "ativo",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   }
  },
  {
   "id": 6,
   "title": "Tasks: duracao (heatmap, Sprint 26)",
   "type": "heatmap",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "pipeline_task_duration_seconds",
     "legendFormat": "{{task}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   }
  },
  {
   "id": 7,
   "title": "Health Index (0-100, Sprint 26)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "pipeline_health_index",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "red"
       },
       {
        "value": 50,
        "color": "orange"
       },
       {
        "value": 70,
        "color": "yellow"
       },
       {
        "value": 90,
        "color": "green"
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 24
   }
  },
  {
   "id": 8,
   "title": "Duracao por task + P95 7d (Sprint 26)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "pipeline_task_duration_seconds",
     "legendFormat": "{{task}} atual",
     "refId": "A"
    },
    {
     "expr": "quantile_over_time(0.95, pipeline_task_duration_seconds[7d])",
     "legendFormat": "{{task}} p95 7d",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 24
   }
  },
  {
   "id": 9,
   "title": "MTTR / MTBF (Sprint 26)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "pipeline_mttr_seconds",
     "legendFormat": "MTTR",
     "refId": "A"
    },
    {
     "expr": "pipeline_mtbf_seconds",
     "legendFormat": "MTBF",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 24
   }
  }
 ]
}